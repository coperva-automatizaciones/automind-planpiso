# ── Supabase CLI ─────────────────────────────────────────────
# Estado local del CLI: refs del proyecto vinculado, versiones, caché.
supabase/.temp/
supabase/.branches/

# ── Secretos ─────────────────────────────────────────────────
# Las Edge Functions leen sus secretos de aquí en local.
# NUNCA commitear: contienen SERVICE_ROLE_KEY, tokens de Brevo/Telegram/OpenAI.
.env
.env.*
!.env.example
supabase/functions/.env

# ── Node ─────────────────────────────────────────────────────
node_modules/
npm-debug.log*
.npm/

# ── Claude Code ──────────────────────────────────────────────
# Las skills (.claude/skills/) SÍ se versionan: son herramienta de equipo.
# La bitácora de sesiones es cuaderno personal de cada quien.
.claude/sessions/

# ── Sistema operativo ────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Herramientas de sesión ───────────────────────────────────
# Capturas, snapshots y logs que deja el navegador automatizado.
.playwright-mcp/

# ── Reportes de entregables ──────────────────────────────────
# Se publican como artifacts y son material de trabajo personal.
# El repositorio conserva la documentación de dominio (01 a 06).
docs/00-INDICE-ENTREGABLES.html
docs/07-ESTADO-FUNCIONAL.html
docs/09-RECORRIDO-FUNCIONAL.html
docs/F1-*.html
docs/F2-*.html
docs/F3-*.html
docs/F4-*.html
docs/F5-*.html
docs/F6-*.html
# Propuestas técnicas — fuera del calendario de fases.
docs/PROP-*.html
docs/img/

# ── Nota ─────────────────────────────────────────────────────
# config.js SÍ se versiona: contiene la anon key, que es pública por diseño.
# En v2 esto cambia — las credenciales pasan a variables de entorno.
